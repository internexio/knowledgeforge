{
  "type": "object",
  "required": ["dimensions", "findings", "injection_flags"],
  "properties": {
    "dimensions": {
      "type": "object",
      "required": ["completeness", "regression_risk", "scope_creep", "unrequested_changes"],
      "additionalProperties": false,
      "properties": {
        "completeness": {"$ref": "#/$defs/dim"}, "regression_risk": {"$ref": "#/$defs/dim"},
        "scope_creep": {"$ref": "#/$defs/dim"}, "unrequested_changes": {"$ref": "#/$defs/dim"}
      }
    },
    "findings": {"type": "array", "items": {"type": "object", "required": ["severity", "location", "claim"],
      "properties": {"severity": {"type": "string"}, "location": {"type": "string"}, "claim": {"type": "string"}}}},
    "injection_flags": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "dim": {"type": "object", "required": ["score", "evidence", "reason"],
      "properties": {"score": {"type": "integer", "minimum": 0, "maximum": 10},
                     "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                     "reason": {"type": "string"}}}
  }
}
